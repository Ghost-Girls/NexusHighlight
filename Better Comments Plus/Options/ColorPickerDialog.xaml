<Window
	x:Class="BetterCommentsPlus.Options.ColorPickerDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="选择颜色"
	Width="320"
	Height="480"
	WindowStartupLocation="CenterOwner"
	mc:Ignorable="d">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<WrapPanel
				x:Name="ColorsWrapPanel"
				Margin="5" />
		</ScrollViewer>

		<GroupBox Grid.Row="1" Header="自定义颜色 (HEX)" Margin="0,10,0,10">
			<Grid Margin="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBox
					x:Name="HexTextBox"
					Grid.Column="0"
					Margin="0,0,10,0"
					TextChanged="HexTextBox_TextChanged"
					ToolTip="输入HEX颜色值，例如：#FF0000 或 FF0000" />

				<Border
					x:Name="PreviewBorder"
					Grid.Column="1"
					Width="40"
					Height="25"
					Margin="0,0,10,0"
					BorderBrush="Gray"
					BorderThickness="1"
					CornerRadius="3" />

				<Button
					Grid.Column="2"
					x:Name="ConfirmHexButton"
					Width="80"
					Content="确认"
					Click="ConfirmHexButton_Click"
					IsEnabled="False" />
			</Grid>
		</GroupBox>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button
				Width="80"
				Height="30"
				Margin="10,0,10,0"
				Click="CancelButton_Click"
				Content="取消" />
		</StackPanel>
	</Grid>
</Window>
