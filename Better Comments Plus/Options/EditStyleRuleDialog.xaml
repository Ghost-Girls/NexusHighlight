<Window
    x:Class="BetterCommentsPlus.Options.EditStyleRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Style Rule"
    Width="660"
    Height="1120"
    Background="#27242b"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="AliceBlue" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="AliceBlue" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="AliceBlue" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel
            Margin="8,8,8,8"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnModify"
                Padding="16,2,16,2"
                Content="Create"
                IsDefault="True" />
            <Button
                x:Name="btnDelete"
                Margin="8,0,0,0"
                Padding="16,2,16,2"
                Content="Delete"
                Visibility="Collapsed" />
            <Button
                x:Name="btnCancel"
                Margin="8,0,0,0"
                Padding="16,2,16,2"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>

        <Border
            MinHeight="48"
            Margin="10,10"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="2"
            DockPanel.Dock="Bottom">
            <Grid
                x:Name="previewGrid"
                MaxHeight="512"
                Background="#1e1e1e">
                <Rectangle
                    x:Name="r"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RadiusX="2"
                    RadiusY="2"
                    StrokeThickness="3" />
                <TextBlock
                    x:Name="t"
                    MaxWidth="512"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="JetBrains Mono"
                    FontSize="24"
                    Foreground="#57a64a"
                    Text="Sample Text"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Background="#27242b" DockPanel.Dock="Top">
                <GroupBox
                    Margin="8,8,8,0"
                    Header="保存位置"
                    Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Margin="4" Orientation="Horizontal">
                        <CheckBox
                            x:Name="chkSaveToGlobal"
                            Margin="0,0,16,0"
                            Content="Global Rules"
                            IsChecked="True"
                            Style="{StaticResource CheckBoxStyle}" />
                        <CheckBox
                            x:Name="chkSaveToSolution"
                            Content="Solution Rules"
                            IsChecked="False"
                            Style="{StaticResource CheckBoxStyle}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Margin="8,8,8,0"
                    Header="Criteria"
                    Style="{StaticResource GroupBoxStyle}">
                    <TextBox
                        x:Name="txtCriteria"
                        Margin="4"
                        Padding="4" />
                </GroupBox>

                <GroupBox
                    Margin="8,8,8,0"
                    Header="Foreground Style"
                    Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="4,4,4,8" Orientation="Horizontal">
                            <Label
                                Width="50"
                                VerticalAlignment="Center"
                                Content="Color"
                                Style="{StaticResource LabelStyle}" />
                            <WrapPanel x:Name="FgColorsWrapPanel" Width="560" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,4" Orientation="Horizontal">
                            <CheckBox
                                x:Name="chkFgActive"
                                Margin="0,0,8,0"
                                Content="Active"
                                IsChecked="True"
                                Style="{StaticResource CheckBoxStyle}" />
                            <Border
                                Margin="0,0,8,0"
                                BorderBrush="Gray"
                                BorderThickness="1,0" />
                            <CheckBox
                                x:Name="chkFgBold"
                                Margin="0,0,8,0"
                                Content="Bold"
                                Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox
                                x:Name="chkFgItalic"
                                Margin="0,0,8,0"
                                Content="Italic"
                                Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox
                                x:Name="chkFgUnderline"
                                Margin="0,0,8,0"
                                Content="Underline"
                                Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox
                                x:Name="chkFgStrikethrough"
                                Content="Strikethrough"
                                Style="{StaticResource CheckBoxStyle}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox
                    Margin="8,8,8,0"
                    Header="Background Style"
                    Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="4,4,4,8" Orientation="Horizontal">
                            <Label
                                Width="50"
                                VerticalAlignment="Center"
                                Content="Color"
                                Style="{StaticResource LabelStyle}" />
                            <WrapPanel x:Name="BgColorsWrapPanel" Width="560" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,4" Orientation="Horizontal">
                            <Label
                                VerticalAlignment="Center"
                                Content="Shape"
                                Style="{StaticResource LabelStyle}" />
                            <ComboBox
                                x:Name="cboShape"
                                Width="110"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Tag" />
                                <ComboBoxItem Content="Underline Tag" />
                                <ComboBoxItem Content="Full Line" />
                                <ComboBoxItem Content="Full Underline" />
                            </ComboBox>

                            <Label
                                VerticalAlignment="Center"
                                Content="Blur"
                                Style="{StaticResource LabelStyle}" />
                            <ComboBox
                                x:Name="cboBlur"
                                Width="75"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                SelectedIndex="0">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Ultra" />
                            </ComboBox>

                            <Label
                                VerticalAlignment="Center"
                                Content="Alpha"
                                Style="{StaticResource LabelStyle}" />
                            <ComboBox
                                x:Name="cboAlpha"
                                Width="60"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                SelectedIndex="1">
                                <ComboBoxItem Content="0%" />
                                <ComboBoxItem Content="10%" />
                                <ComboBoxItem Content="20%" />
                                <ComboBoxItem Content="30%" />
                                <ComboBoxItem Content="40%" />
                                <ComboBoxItem Content="50%" />
                                <ComboBoxItem Content="60%" />
                                <ComboBoxItem Content="70%" />
                                <ComboBoxItem Content="80%" />
                                <ComboBoxItem Content="90%" />
                                <ComboBoxItem Content="100%" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="4,4,4,4" Orientation="Horizontal">
                            <CheckBox
                                x:Name="chkBgActive"
                                Margin="0,0,8,0"
                                Content="Active"
                                Style="{StaticResource CheckBoxStyle}" />
                            <Border
                                Margin="0,0,8,0"
                                BorderBrush="Gray"
                                BorderThickness="1,0" />
                            <CheckBox
                                x:Name="chkCaseSensitive"
                                Margin="0,0,8,0"
                                Content="Case Sensitive"
                                IsChecked="True"
                                Style="{StaticResource CheckBoxStyle}" />
                            <CheckBox
                                x:Name="chkPartialMatch"
                                Content="Allow Partial Matches"
                                Style="{StaticResource CheckBoxStyle}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
