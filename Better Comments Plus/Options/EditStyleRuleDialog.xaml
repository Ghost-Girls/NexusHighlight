<Window x:Class="BetterCommentsPlus.Options.EditStyleRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Style Rule"
        Width="520"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <DockPanel>
        <StackPanel Margin="8,8,8,8"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
            <Button x:Name="btnModify"
                    Padding="16,2,16,2"
                    Content="Create"
                    IsDefault="True" />
            <Button x:Name="btnDelete"
                    Margin="8,0,0,0"   
                    Padding="16,2,16,2"
                    Content="Delete" 
                    Visibility="Collapsed" />
            <Button x:Name="btnCancel"
                    Margin="8,0,0,0"
                    Padding="16,2,16,2"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>

        <Border MinHeight="48"
                Margin="16,1,16,0"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="2"
                DockPanel.Dock="Bottom">
            <Grid x:Name="previewGrid" MaxHeight="512">
                <Rectangle x:Name="r"
                           Height="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RadiusX="2"
                           RadiusY="2"
                           StrokeThickness="3" />
                <TextBlock x:Name="t"
                           MaxWidth="512"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="Black"
                           Text="Sample Text"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Background="#F5F5F5" DockPanel.Dock="Top">
                <GroupBox Header="保存位置" Margin="8,8,8,0">
                    <StackPanel Margin="4" Orientation="Horizontal">
                        <CheckBox x:Name="chkSaveToGlobal" Content="Global Rules" Margin="0,0,16,0" IsChecked="True" />
                        <CheckBox x:Name="chkSaveToSolution" Content="Solution Rules" IsChecked="False" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Criteria" Margin="8,8,8,0">
                    <TextBox x:Name="txtCriteria" 
                             Margin="4" 
                             Padding="4" />
                </GroupBox>

                <GroupBox Header="Foreground Style" Margin="8,8,8,0">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="4,4,4,8" Orientation="Horizontal">
                            <Label VerticalAlignment="Center" Content="Color" Width="50"/>
                            <ListBox x:Name="lstFgColors"
                                     Width="400"
                                     Height="60"
                                     BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="400"
                                                   ItemHeight="24"
                                                   ItemWidth="24" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Margin="4,0,4,4" Orientation="Horizontal">
                            <CheckBox x:Name="chkFgBold" Content="Bold" Margin="0,0,8,0" />
                            <CheckBox x:Name="chkFgItalic" Content="Italic" Margin="0,0,8,0" />
                            <CheckBox x:Name="chkFgUnderline" Content="Underline" Margin="0,0,8,0" />
                            <CheckBox x:Name="chkFgStrikethrough" Content="Strikethrough" />
                        </StackPanel>
                        <StackPanel Margin="4,4,4,4" Orientation="Horizontal">
                            <CheckBox x:Name="chkFgActive" Content="Active" Margin="0,0,8,0" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Background Style" Margin="8,8,8,0">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="4,4,4,8" Orientation="Horizontal">
                            <Label VerticalAlignment="Center" Content="Color" Width="50"/>
                            <ListBox x:Name="lstBgColors"
                                     Width="400"
                                     Height="60"
                                     BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="400"
                                                   ItemHeight="24"
                                                   ItemWidth="24" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Margin="4,0,4,4" Orientation="Horizontal">
                            <Label VerticalAlignment="Center" Content="Shape" />
                            <ComboBox x:Name="cboShape"
                                      Width="110"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Tag" />
                                <ComboBoxItem Content="Underline Tag" />
                                <ComboBoxItem Content="Full Line" />
                                <ComboBoxItem Content="Full Underline" />
                            </ComboBox>

                            <Label VerticalAlignment="Center" Content="Blur" />
                            <ComboBox x:Name="cboBlur"
                                      Width="75"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Ultra" />
                            </ComboBox>
                            
                            <Label VerticalAlignment="Center" Content="Alpha" />
                            <ComboBox x:Name="cboAlpha"
                                      Width="60"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="0%" />
                                <ComboBoxItem Content="10%" />
                                <ComboBoxItem Content="20%" />
                                <ComboBoxItem Content="30%" />
                                <ComboBoxItem Content="40%" />
                                <ComboBoxItem Content="50%" />
                                <ComboBoxItem Content="60%" />
                                <ComboBoxItem Content="70%" />
                                <ComboBoxItem Content="80%" />
                                <ComboBoxItem Content="90%" />
                                <ComboBoxItem Content="100%" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="4,4,4,4" Orientation="Horizontal">
                            <CheckBox x:Name="chkBgActive" Content="Active" Margin="0,0,8,0" />
                            <CheckBox x:Name="chkCaseSensitive" Content="Case Sensitive" Margin="0,0,8,0" IsChecked="True" />
                            <CheckBox x:Name="chkPartialMatch" Content="Allow Partial Matches" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
