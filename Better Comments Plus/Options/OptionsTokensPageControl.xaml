<UserControl
    x:Class="BetterCommentsPlus.Options.OptionsTokensPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BetterCommentsPlus.Options"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Width="850"
    d:DataContext="{d:DesignInstance {x:Type local:Settings}}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:HexToColorConverter x:Key="HexToColorConverter" />

        <Style x:Key="TokenValueTextBoxStyle" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="Validation.ErrorTemplate">
                        <Setter.Value>
                            <ControlTemplate>
                                <DockPanel>
                                    <Border BorderBrush="Red" BorderThickness="2">
                                        <AdornedElementPlaceholder />
                                    </Border>
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="Red">
                                        !
                                    </TextBlock>
                                </DockPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TokensListDataTemplate">
            <Border
                Margin="0,0,0,5"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            x:Name="DragGrip"
                            Width="24"
                            Height="24"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="SizeAll"
                            PreviewMouseLeftButtonDown="DragGrip_PreviewMouseLeftButtonDown">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="Gray"
                                Text="☰" />
                        </Border>

                        <TextBox
                            Width="120"
                            Padding="3,0"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource TokenValueTextBoxStyle}">

                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    Path="CurrentValue"
                                    UpdateSourceTrigger="LostFocus">
                                    <Binding.ValidationRules>
                                        <local:RequiredAndUniqueRule ValidationStep="CommittedValue" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <Border
                            Width="1"
                            Height="24"
                            Margin="5,0,5,0"
                            Background="LightGray" />

                        <Border
                            x:Name="ColorPreviewBorder"
                            Width="28"
                            Height="24"
                            Margin="0,0,5,0"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseLeftButtonDown="ColorPreviewBorder_MouseLeftButtonDown">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" />
                            </Border.Background>
                        </Border>

                        <CheckBox
                            Width="24"
                            Height="24"
                            Margin="0,0,3,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsChecked="{Binding IsBold, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="粗体">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Text="B" />
                        </CheckBox>

                        <CheckBox
                            Width="24"
                            Height="24"
                            Margin="0,0,3,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsChecked="{Binding IsItalic, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="斜体">
                            <TextBlock
                                FontSize="12"
                                FontStyle="Italic"
                                Text="I" />
                        </CheckBox>

                        <CheckBox
                            Width="24"
                            Height="24"
                            Margin="0,0,3,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsChecked="{Binding HasUnderline, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="下划线">
                            <TextBlock
                                FontSize="12"
                                Text="U"
                                TextDecorations="Underline" />
                        </CheckBox>

                        <CheckBox
                            Width="24"
                            Height="24"
                            Margin="0,0,3,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsChecked="{Binding HasStrikethrough, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="删除线">
                            <TextBlock
                                FontSize="12"
                                Text="S"
                                TextDecorations="Strikethrough" />
                        </CheckBox>

                        <Border
                            Width="1"
                            Height="24"
                            Margin="5,0,5,0"
                            Background="LightGray" />

                        <CheckBox
                            Width="36"
                            Height="24"
                            Margin="0,0,5,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsChecked="{Binding BackgroundStyle.IsActive, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="启用背景">
                            <TextBlock
                                FontSize="12"
                                Text="🎨" />
                        </CheckBox>

                        <Border
                            Width="28"
                            Height="24"
                            Margin="0,0,5,0"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseLeftButtonDown="BackgroundColorPreviewBorder_MouseLeftButtonDown">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding BackgroundStyle.ColorHex, Converter={StaticResource HexToColorConverter}}" />
                            </Border.Background>
                        </Border>

                        <ComboBox
                            Width="65"
                            Height="24"
                            Margin="0,0,5,0"
                            Padding="2"
                            SelectedItem="{Binding BackgroundStyle.Shape, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>Tag</sys:String>
                            <sys:String>TagUnder</sys:String>
                            <sys:String>Line</sys:String>
                            <sys:String>LineUnder</sys:String>
                        </ComboBox>

                        <ComboBox
                            Width="55"
                            Height="24"
                            Margin="0,0,5,0"
                            Padding="2"
                            SelectedItem="{Binding BackgroundStyle.Blur, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>None</sys:String>
                            <sys:String>Low</sys:String>
                            <sys:String>Medium</sys:String>
                            <sys:String>High</sys:String>
                            <sys:String>Ultra</sys:String>
                        </ComboBox>

                        <ComboBox
                            Width="55"
                            Height="24"
                            Margin="0,0,5,0"
                            Padding="2"
                            SelectedItem="{Binding BackgroundStyle.Alpha, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>0/10</sys:String>
                            <sys:String>1/10</sys:String>
                            <sys:String>2/10</sys:String>
                            <sys:String>3/10</sys:String>
                            <sys:String>4/10</sys:String>
                            <sys:String>5/10</sys:String>
                            <sys:String>6/10</sys:String>
                            <sys:String>7/10</sys:String>
                            <sys:String>8/10</sys:String>
                            <sys:String>9/10</sys:String>
                            <sys:String>10/10</sys:String>
                        </ComboBox>

                        <CheckBox
                            Width="70"
                            Height="24"
                            Margin="0,0,5,0"
                            Padding="2"
                            Content="区分大小写"
                            IsChecked="{Binding BackgroundStyle.IsCaseSensitive, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox
                            Width="70"
                            Height="24"
                            Margin="0,0,5,0"
                            Padding="2"
                            Content="部分匹配"
                            IsChecked="{Binding BackgroundStyle.AllowPartialMatch, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Width="50"
                            Height="24"
                            Margin="5,0,0,0"
                            Padding="5,0"
                            Click="DeleteButton_Click"
                            Content="Delete"
                            Tag="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10,10,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="Auto"
                MinWidth="700"
                MaxWidth="1000" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,0,5"
            Orientation="Horizontal">
            <Button
                x:Name="AddButton"
                Width="70"
                Height="24"
                Margin="0,0,5,0"
                Click="AddButton_Click"
                Content="Add" />
            <CheckBox
                Width="120"
                Height="24"
                Margin="5,0,0,0"
                Padding="5,0"
                VerticalContentAlignment="Center"
                IsChecked="{Binding HighlightCriteriaItself, UpdateSourceTrigger=PropertyChanged}"
                Content="高亮 Criteria 本身"
                ToolTip="启用后，匹配的 Criteria 文本本身也会应用样式（如 &quot;#IMPORTANT&quot;）" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox
                    x:Name="TokensList"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource TokensListDataTemplate}"
                    ItemsSource="{Binding CommentTokens, Mode=OneWay}"
                    MouseMove="TokensList_MouseMove"
                    PreviewMouseLeftButtonUp="TokensList_PreviewMouseLeftButtonUp" />
            </ScrollViewer>

            <Rectangle
                x:Name="DropIndicator"
                Height="2"
                Margin="0,-1,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Fill="#FF007ACC"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Orientation="Vertical">
            <Button
                Width="94"
                Height="24"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding ResetTokens}"
                Content="_Reset" />
        </StackPanel>
    </Grid>
</UserControl>
