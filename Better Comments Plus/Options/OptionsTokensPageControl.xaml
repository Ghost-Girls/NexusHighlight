<UserControl
    x:Class="BetterCommentsPlus.Options.OptionsTokensPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BetterCommentsPlus.Options"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="630"
    d:DataContext="{d:DesignInstance {x:Type local:Settings}}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:EnumToStringConverter x:Key="EnumToStringConverter" />
        <local:HexToColorConverter x:Key="HexToColorConverter" />

        <Style x:Key="TokenValueTextBoxStyle" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    <Setter Property="Validation.ErrorTemplate">
                        <Setter.Value>
                            <ControlTemplate>
                                <DockPanel>
                                    <Border BorderBrush="Red" BorderThickness="2">
                                        <AdornedElementPlaceholder />
                                    </Border>
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="Red">
                                        !
                                    </TextBlock>
                                </DockPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TokensListDataTemplate">
            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                <Border
                    x:Name="DragGrip"
                    Width="24"
                    Height="24"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="SizeAll"
                    PreviewMouseLeftButtonDown="DragGrip_PreviewMouseLeftButtonDown">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="Gray"
                        Text="☰" />
                </Border>

                <Label
                    Width="85"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Right"
                    Content="{Binding Type, Converter={StaticResource EnumToStringConverter}, Mode=OneWay}" />

                <TextBox
                    Width="200"
                    Padding="3,0"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource TokenValueTextBoxStyle}">

                    <TextBox.Text>
                        <Binding
                            Mode="TwoWay"
                            Path="CurrentValue"
                            UpdateSourceTrigger="LostFocus">
                            <Binding.ValidationRules>
                                <local:RequiredAndUniqueRule ValidationStep="CommittedValue" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <Border
                    x:Name="ColorPreviewBorder"
                    Width="32"
                    Height="24"
                    Margin="5,0,0,0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="3"
                    Cursor="Hand"
                    MouseLeftButtonDown="ColorPreviewBorder_MouseLeftButtonDown">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" />
                    </Border.Background>
                </Border>

                <CheckBox
                    Width="28"
                    Height="24"
                    Margin="5,0,0,0"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsBold, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="B">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="B" />
                </CheckBox>

                <CheckBox
                    Width="28"
                    Height="24"
                    Margin="2,0,0,0"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsItalic, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="I">
                    <TextBlock
                        FontSize="14"
                        FontStyle="Italic"
                        Text="I" />
                </CheckBox>

                <CheckBox
                    Width="28"
                    Height="24"
                    Margin="2,0,0,0"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding HasUnderline, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="U">
                    <TextBlock
                        FontSize="14"
                        Text="U"
                        TextDecorations="Underline" />
                </CheckBox>

                <CheckBox
                    Width="28"
                    Height="24"
                    Margin="2,0,0,0"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding HasStrikethrough, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="S">
                    <TextBlock
                        FontSize="14"
                        Text="S"
                        TextDecorations="Strikethrough" />
                </CheckBox>

                <Button
                    Width="50"
                    Height="24"
                    Margin="5,0,0,0"
                    Padding="5,0"
                    Click="DeleteButton_Click"
                    Content="Delete"
                    Tag="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10,10,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="Auto"
                MinWidth="500"
                MaxWidth="800" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,0,5"
            Orientation="Horizontal">
            <Button
                x:Name="AddButton"
                Width="70"
                Height="24"
                Margin="0,0,5,0"
                Click="AddButton_Click"
                Content="Add" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox
                    x:Name="TokensList"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource TokensListDataTemplate}"
                    ItemsSource="{Binding CommentTokens, Mode=OneWay}"
                    MouseMove="TokensList_MouseMove"
                    PreviewMouseLeftButtonUp="TokensList_PreviewMouseLeftButtonUp" />
            </ScrollViewer>

            <Rectangle
                x:Name="DropIndicator"
                Height="2"
                Margin="0,-1,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Fill="#FF007ACC"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Orientation="Vertical">
            <Button
                Width="94"
                Height="24"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding ResetTokens}"
                Content="_Reset" />
        </StackPanel>
    </Grid>
</UserControl>
