<UserControl
	x:Class="BetterCommentsPlus.Options.OptionsTokensPageControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:BetterCommentsPlus.Options"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Width="520"
	d:DataContext="{d:DesignInstance {x:Type local:Settings}}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<local:EnumToStringConverter x:Key="EnumToStringConverter" />
		<local:HexToColorConverter x:Key="HexToColorConverter" />

		<Style x:Key="TokenValueTextBoxStyle" TargetType="{x:Type TextBox}">
			<Style.Triggers>
				<Trigger Property="Validation.HasError" Value="true">
					<Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
					<Setter Property="Validation.ErrorTemplate">
						<Setter.Value>
							<ControlTemplate>
								<DockPanel>
									<Border BorderBrush="Red" BorderThickness="2">
										<AdornedElementPlaceholder />
									</Border>
									<TextBlock
										Margin="5,0,0,0"
										FontSize="20"
										FontWeight="Bold"
										Foreground="Red">
										!
									</TextBlock>
								</DockPanel>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>

		<DataTemplate x:Key="TokensListDataTemplate">
			<StackPanel Margin="0,0,0,5" Orientation="Horizontal">
				<Label
					Width="85"
					Margin="0,0,5,0"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					HorizontalContentAlignment="Right"
					Content="{Binding Type, Converter={StaticResource EnumToStringConverter}, Mode=OneWay}" />

				<TextBox
					Width="200"
					Padding="3,0"
					VerticalContentAlignment="Center"
					Style="{StaticResource TokenValueTextBoxStyle}">

					<TextBox.Text>
						<Binding
							Mode="TwoWay"
							Path="CurrentValue"
							UpdateSourceTrigger="LostFocus">
							<Binding.ValidationRules>
								<local:RequiredAndUniqueRule ValidationStep="CommittedValue" />
							</Binding.ValidationRules>
						</Binding>
					</TextBox.Text>
				</TextBox>

				<Border
					x:Name="ColorPreviewBorder"
					Width="30"
					Height="20"
					Margin="5,0,0,0"
					BorderBrush="Gray"
					BorderThickness="1"
					CornerRadius="3"
					Cursor="Hand"
					MouseLeftButtonDown="ColorPreviewBorder_MouseLeftButtonDown">
					<Border.Background>
						<SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" />
					</Border.Background>
				</Border>

				<Button
					Width="50"
					Height="20"
					Margin="5,0,0,0"
					Padding="5,0"
					Click="DeleteButton_Click"
					Content="Delete"
					Tag="{Binding}" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<Grid Margin="10,10,10,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="400" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
			<Button
				x:Name="AddButton"
				Width="70"
				Height="24"
				Margin="0,0,5,0"
				Click="AddButton_Click"
				Content="Add" />
		</StackPanel>

		<ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
			<ListBox
				x:Name="TokensList"
				ItemTemplate="{StaticResource TokensListDataTemplate}"
				ItemsSource="{Binding CommentTokens, Mode=OneWay}"
				BorderThickness="0"
				AllowDrop="True"
				PreviewMouseLeftButtonDown="TokensList_PreviewMouseLeftButtonDown"
				MouseMove="TokensList_MouseMove"
				DragEnter="TokensList_DragEnter"
				DragOver="TokensList_DragOver"
				DragLeave="TokensList_DragLeave"
				Drop="TokensList_Drop" />
		</ScrollViewer>

		<StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Vertical">
			<Button
				Width="94"
				Height="24"
				Margin="5"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Command="{Binding ResetTokens}"
				Content="_Reset" />
		</StackPanel>
	</Grid>
</UserControl>
