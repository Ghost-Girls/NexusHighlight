<Grid
    x:Class="Highlighter.Options.HighlighterOptionsPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Highlighter.Options"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />

        <!--  ListBoxItem 样式  -->
        <Style x:Key="RuleListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  性能设置  -->
    <GroupBox
        Grid.Row="0"
        Margin="10"
        Header="Appearance">
        <StackPanel Margin="10" Orientation="Horizontal">
            <TextBlock
                Width="100"
                VerticalAlignment="Center"
                Text="Performance:" />
            <ComboBox
                x:Name="PerformanceComboBox"
                Width="150"
                SelectedIndex="1"
                SelectionChanged="PerformanceComboBox_SelectionChanged">
                <ComboBoxItem Tag="Normal">Normal</ComboBoxItem>
                <ComboBoxItem Tag="Fast">Fast</ComboBoxItem>
                <ComboBoxItem Tag="NoEffects">No Effects</ComboBoxItem>
            </ComboBox>
        </StackPanel>
    </GroupBox>

    <!--  规则设置  -->
    <TabControl Grid.Row="1" Margin="10">
        <!--  Global Rules  -->
        <TabItem Header="Global Rules">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="5"
                    FontStyle="Italic"
                    Text="These rules are applied across all projects." />
                <StackPanel
                    Grid.Row="1"
                    Margin="5"
                    Orientation="Horizontal">
                    <Button
                        x:Name="AddGlobalRuleButton"
                        Margin="0,0,5,0"
                        Click="AddGlobalRuleButton_Click"
                        Content="Add Global Rule" />
                    <Button
                        x:Name="ExportGlobalRulesButton"
                        Margin="0,0,5,0"
                        Click="ExportGlobalRulesButton_Click"
                        Content="Export Global Rules" />
                    <Button
                        x:Name="ImportGlobalRulesButton"
                        Click="ImportGlobalRulesButton_Click"
                        Content="Import Global Rules" />
                </StackPanel>

                <!--  表头  -->
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  表头行  -->
                    <Grid
                        Grid.Row="0"
                        Height="28"
                        Background="#F0F0F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="IsActive" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Color" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Criteria" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Shape" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Blur" />
                        <TextBlock
                            Grid.Column="5"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Alpha" />
                        <TextBlock
                            Grid.Column="6"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="IsCaseSensitive" />
                        <TextBlock
                            Grid.Column="7"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="AllowPartialMatch" />
                        <TextBlock
                            Grid.Column="8"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Actions" />
                    </Grid>

                    <!--  ListBox  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox
                            x:Name="GlobalRulesListBox"
                            AllowDrop="True"
                            BorderThickness="0"
                            DragEnter="GlobalRulesListBox_DragEnter"
                            DragLeave="GlobalRulesListBox_DragLeave"
                            DragOver="GlobalRulesListBox_DragOver"
                            Drop="GlobalRulesListBox_Drop"
                            ItemContainerStyle="{StaticResource RuleListBoxItemStyle}"
                            ItemsSource="{Binding ColorTags}"
                            MouseMove="GlobalRulesListBox_MouseMove"
                            PreviewMouseLeftButtonDown="GlobalRulesListBox_PreviewMouseLeftButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Active  -->
                                        <CheckBox
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Color  -->
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="60"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableColors, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="40" Height="15">
                                                        <Rectangle.Fill>
                                                            <SolidColorBrush Color="{Binding}" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!--  Criteria  -->
                                        <TextBox
                                            Grid.Column="2"
                                            Margin="2,0"
                                            Padding="3,0"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Criteria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Shape  -->
                                        <ComboBox
                                            Grid.Column="3"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableShapes, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Shape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Blur  -->
                                        <ComboBox
                                            Grid.Column="4"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableBlurLevels, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Blur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Alpha  -->
                                        <ComboBox
                                            Grid.Column="5"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableAlphaLevels, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Alpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Case Sensitive  -->
                                        <CheckBox
                                            Grid.Column="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsCaseSensitive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Partial Match  -->
                                        <CheckBox
                                            Grid.Column="7"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding AllowPartialMatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Actions  -->
                                        <StackPanel
                                            Grid.Column="8"
                                            Margin="2,0"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="2"
                                                Padding="5,2"
                                                Click="CopyToSolutionButton_Click"
                                                Content="Copy"
                                                Tag="{Binding}" />
                                            <Button
                                                Margin="2"
                                                Padding="5,2"
                                                Click="DeleteGlobalRuleButton_Click"
                                                Content="Delete"
                                                Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <!--  Solution Rules  -->
        <TabItem Header="Solution Rules">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="5"
                    FontStyle="Italic"
                    Text="These rules are applied only to the current solution." />
                <StackPanel
                    Grid.Row="1"
                    Margin="5"
                    Orientation="Horizontal">
                    <Button
                        x:Name="CopyAllFromGlobalButton"
                        Margin="0,0,5,0"
                        Click="CopyAllFromGlobalButton_Click"
                        Content="Copy from Global" />
                    <Button
                        x:Name="ImportFromGlobalButton"
                        Margin="0,0,5,0"
                        Click="ImportFromGlobalButton_Click"
                        Content="Import from Global" />
                    <Button
                        x:Name="ClearSolutionRulesButton"
                        Margin="0,0,5,0"
                        Click="ClearSolutionRulesButton_Click"
                        Content="Clear All" />
                    <Button
                        x:Name="ExportSolutionRulesButton"
                        Margin="0,0,5,0"
                        Click="ExportSolutionRulesButton_Click"
                        Content="Export" />
                    <Button
                        x:Name="ImportSolutionRulesButton"
                        Click="ImportSolutionRulesButton_Click"
                        Content="Import" />
                </StackPanel>

                <!--  表头  -->
                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  表头行  -->
                    <Grid
                        Grid.Row="0"
                        Height="28"
                        Background="#F0F0F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Active" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Color" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Criteria" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Shape" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Blur" />
                        <TextBlock
                            Grid.Column="5"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Alpha" />
                        <TextBlock
                            Grid.Column="6"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Case" />
                        <TextBlock
                            Grid.Column="7"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Partial" />
                        <TextBlock
                            Grid.Column="8"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Actions" />
                    </Grid>

                    <!--  ListBox  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox
                            x:Name="SolutionRulesListBox"
                            AllowDrop="True"
                            BorderThickness="0"
                            DragEnter="SolutionRulesListBox_DragEnter"
                            DragLeave="SolutionRulesListBox_DragLeave"
                            DragOver="SolutionRulesListBox_DragOver"
                            Drop="SolutionRulesListBox_Drop"
                            ItemContainerStyle="{StaticResource RuleListBoxItemStyle}"
                            ItemsSource="{Binding SolutionTags}"
                            MouseMove="SolutionRulesListBox_MouseMove"
                            PreviewMouseLeftButtonDown="SolutionRulesListBox_PreviewMouseLeftButtonDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Active  -->
                                        <CheckBox
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Color  -->
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="60"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableColors, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="40" Height="15">
                                                        <Rectangle.Fill>
                                                            <SolidColorBrush Color="{Binding}" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!--  Criteria  -->
                                        <TextBox
                                            Grid.Column="2"
                                            Margin="2,0"
                                            Padding="3,0"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Criteria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Shape  -->
                                        <ComboBox
                                            Grid.Column="3"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableShapes, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Shape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Blur  -->
                                        <ComboBox
                                            Grid.Column="4"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableBlurLevels, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Blur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Alpha  -->
                                        <ComboBox
                                            Grid.Column="5"
                                            Margin="2,0"
                                            ItemsSource="{Binding DataContext.AvailableAlphaLevels, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            SelectedItem="{Binding Alpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Case Sensitive  -->
                                        <CheckBox
                                            Grid.Column="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsCaseSensitive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Partial Match  -->
                                        <CheckBox
                                            Grid.Column="7"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding AllowPartialMatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--  Actions  -->
                                        <Button
                                            Grid.Column="8"
                                            Margin="2"
                                            Padding="5,2"
                                            Click="DeleteSolutionRuleButton_Click"
                                            Content="Delete"
                                            Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Grid>
